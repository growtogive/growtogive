datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id               String        @id @default(cuid())
  email            String        @unique
  password         String?
  name             String?
  role             String        @default("USER")
  city             String?       @default("Bradenton")
  state            String?       @default("FL")
  churchName       String?       @default("Grace Family Church")
  address          String?
  latitude         Float?
  longitude        Float?
  bio              String?
  avatar           String?
  growbucks        Float         @default(10.00)
  emailVerified    Boolean       @default(false)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  listings         Listing[]
  reviews          Review[]      @relation("TargetUserReviews")
  authReviews      Review[]      @relation("AuthorReviews")
  sentTx           Transaction[] @relation("SentTransactions")
  receivedTx       Transaction[] @relation("ReceivedTransactions")
  sentMessages     Message[]     @relation("SentMessages")
  receivedMessages Message[]     @relation("ReceivedMessages")
  quizAttempts     QuizAttempt[]
}

model Listing {
  id           String   @id @default(cuid())
  title        String
  description  String
  type         String   @default("OFFER") // "OFFER", "REQUEST", "COMMERCIAL"
  category     String   // Required string without default
  priceInBucks Float    @default(0.00)
  
  // Media fields (imageUrl kept for legacy compatibility, images array & videoUrl for upgrades)
  imageUrl     String?  
  images       String[] @default([])
  videoUrl     String?

  // Upgrade & Tier Fields
  isFeatured   Boolean  @default(false)
  isCommercial Boolean  @default(false)
  expiresAt    DateTime @default(dbgenerated("NOW() + INTERVAL '30 days'"))
  
  // Location fields (primarily for Commercial storefronts)
  location     String?
  city         String?
  latitude     Float?
  longitude    Float?

  // Commercial-only field
  businessHours String?

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  authorId     String
  author       User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  
  reviews      Review[]
  messages     Message[]
}

model Review {
  id           String   @id @default(cuid())
  rating       Int      @default(5)
  comment      String
  reply        String?
  createdAt    DateTime @default(now())
  
  authorId     String
  author       User     @relation("AuthorReviews", fields: [authorId], references: [id], onDelete: Cascade)
  
  targetUserId String
  targetUser   User     @relation("TargetUserReviews", fields: [targetUserId], references: [id], onDelete: Cascade)
  
  listingId    String?
  listing      Listing? @relation(fields: [listingId], references: [id], onDelete: SetNull)
}

model Transaction {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  reason      String   // Listing title or activity description
  amount      Float    // Total transferred amount
  commission  Float?   // Optional commission amount
  netAmount   Float?   // Optional net amount
  type        String   @default("TRANSFER") // "TRANSFER", "ACTIVITY", etc.
  
  senderId    String?
  sender      User?    @relation("SentTransactions", fields: [senderId], references: [id], onDelete: Cascade)
  
  receiverId  String
  receiver    User     @relation("ReceivedTransactions", fields: [receiverId], references: [id], onDelete: Cascade)
}

model Message {
  id          String   @id @default(uuid())
  listingId   String
  listing     Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  senderId    String
  sender      User     @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  receiverId  String
  receiver    User     @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)
  content     String   @db.Text
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([listingId])
  @@index([receiverId])
}

model PostCategory {
  id    String @id @default(uuid())
  name  String @unique
  posts Post[]
}

model Quiz {
  id                String        @id @default(uuid())
  postId            String        @unique
  post              Post          @relation(fields: [postId], references: [id], onDelete: Cascade)
  question          String
  options           String[]      // JSON array of options
  correctAnswer     Int           // Index of correct option
  rewardAmount      Float         // Growbucks awarded on pass
  passingPercentage Int           @default(100) // Passing percentage threshold
  attempts          QuizAttempt[]
}

model QuizAttempt {
  id        String   @id @default(uuid())
  quizId    String
  quiz      Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  passed    Boolean  @default(false)
  score     Float    @default(0.00)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([quizId, userId])
}

model Event {
  id           String   @id @default(uuid())
  postId       String   @unique
  post         Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  eventDate    DateTime
  location     String?
  rewardAmount Float    // Growbucks awarded when attended
}

model Post {
  id           String        @id @default(uuid())
  title        String
  description  String
  images       String[]      // Up to 5 images
  videoUrl     String?
  price        Float?        // Optional price for events/items
  categoryId   String
  category     PostCategory  @relation(fields: [categoryId], references: [id])
  quiz         Quiz?
  event        Event?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}