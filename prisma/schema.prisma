datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  password      String?
  name          String?
  role          String    @default("USER")
  city          String?   @default("Bradenton")
  state         String?   @default("FL")
  churchName    String?   @default("Grace Family Church")
  address       String?
  latitude      Float?
  longitude     Float?
  bio           String?
  avatar        String?
  growbucks     Float     @default(10.00)
  emailVerified Boolean   @default(false) // 🎯 Required for email confirmation check
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  listings      Listing[]
  reviews       Review[]  @relation("TargetUserReviews")
  authReviews   Review[]  @relation("AuthorReviews")
}

model Listing {
  id            String   @id @default(cuid())
  title         String
  description   String
  type          String   @default("OFFER") // "OFFER", "REQUEST", "COMMERCIAL"
  category      String   @default("GOODS") // "GOODS", "SERVICES", "SKILLS", "RIDES"
  priceInBucks  Float    @default(0.00)
  imageUrl      String?
  
  // Location fields (primarily for Commercial storefronts)
  location      String?
  city          String?
  latitude      Float?
  longitude     Float?

  // Commercial-only field
  businessHours String?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  authorId      String
  author        User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  
  reviews       Review[]
}

model Review {
  id            String   @id @default(cuid())
  rating        Int      @default(5)
  comment       String
  reply         String?
  createdAt     DateTime @default(now())
  
  authorId      String
  author        User     @relation("AuthorReviews", fields: [authorId], references: [id], onDelete: Cascade)
  
  targetUserId  String
  targetUser    User     @relation("TargetUserReviews", fields: [targetUserId], references: [id], onDelete: Cascade)
  
  listingId     String?
  listing       Listing? @relation(fields: [listingId], references: [id], onDelete: SetNull)
}