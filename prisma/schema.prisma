generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String        @id @default(cuid())
  email           String        @unique
  name            String?
  password        String?
  city            String?
  state           String?
  churchName      String?
  userPhone       String?
  growbucks       Float         @default(0.0)
  latitude        Float?
  longitude       Float?
  avatar          String?
  bio             String?
  address         String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  listings        Listing[]
  reviews         Review[]      @relation("UserReviews")
  authoredReviews Review[]      @relation("ReviewAuthor")
  favorites       Favorite[]    @relation("UserFavorites")
  targetFavorites Favorite[]    @relation("TargetUserFavorites")
  sentTx          Transaction[] @relation("SentTransactions")
  receivedTx      Transaction[] @relation("ReceivedTransactions")
}

model Listing {
  id          String     @id @default(cuid())
  userId      String
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt   DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  reviews     Review[]
  favorites   Favorite[]
}

model Review {
  id          String   @id @default(cuid())
  authorId    String
  author      User     @relation("ReviewAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  userId      String?
  user        User?    @relation("UserReviews", fields: [userId], references: [id], onDelete: Cascade)
  listingId   String?
  listing     Listing? @relation(fields: [listingId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
}

model Favorite {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation("UserFavorites", fields: [userId], references: [id], onDelete: Cascade)
  targetUserId String?
  targetUser   User?     @relation("TargetUserFavorites", fields: [targetUserId], references: [id], onDelete: Cascade)
  listingId    String?
  listing      Listing?  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  createdAt    DateTime  @default(now())
}

model Transaction {
  id          String   @id @default(cuid())
  senderId    String
  sender      User     @relation("SentTransactions", fields: [senderId], references: [id], onDelete: Cascade)
  receiverId  String
  receiver    User     @relation("ReceivedTransactions", fields: [receiverId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
}