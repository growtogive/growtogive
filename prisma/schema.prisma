datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                String         @id @default(cuid())
  email             String         @unique
  name              String?
  churchName        String?
  city              String?
  state             String?
  searchRadiusMiles Int?
  listings          Listing[]
  reviewsAuthored   Review[]       @relation("ReviewAuthor")
  reviewsReceived   Review[]       @relation("ReviewTarget")
  notifications     Notification[]
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @default(now()) @updatedAt
}

model Listing {
  id           String   @id @default(cuid())
  title        String
  description  String
  category     String   @default("General")
  type         String
  priceInBucks Float    @default(0)
  imageUrl     String?
  websiteUrl   String?  // Added to match app/api/listings/create/route.ts
  churchName   String?
  city         String?
  authorId     String
  author       User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  reviews      Review[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt
}

model Review {
  id             String    @id @default(cuid())
  rating         Int       @default(5)
  comment        String
  replyText      String?
  replyCreatedAt DateTime? // Added to match app/api/reviews/reply/route.ts
  parentId       String?
  parent         Review?   @relation("ReviewReplies", fields: [parentId], references: [id], onDelete: SetNull)
  replies        Review[]  @relation("ReviewReplies")
  
  listingId      String?
  listing        Listing?  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  
  authorId       String
  author         User      @relation("ReviewAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  
  targetUserId   String?
  targetUser     User?     @relation("ReviewTarget", fields: [targetUserId], references: [id], onDelete: SetNull)
  
  recipientId    String?
  
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @default(now()) @updatedAt
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String?  // Added to match app/api/reviews/reply/route.ts
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}